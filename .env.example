# Public frontend build-time values. Leave unset for offline-only builds.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_MULTIPLAYER_URL=wss://YOUR_GAME_SERVER/ws
# Development: omit VITE_MULTIPLAYER_URL to use Vite's local /ws proxy.

# Server ONLY. Never prefix secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
HOST=0.0.0.0
PORT=3001
ALLOWED_ORIGINS=https://YOUR_FRONTEND
RESULT_OUTBOX_PATH=.data/match-outbox.json
# NODE_ENV=production
